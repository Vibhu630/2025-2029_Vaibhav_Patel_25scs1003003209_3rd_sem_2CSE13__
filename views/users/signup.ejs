<% layout("/layouts/boilerplate") %>

<div class="row mt-3"> 
    <h1 class="col-6 offset-3"> <b>SignUp on StayNest </b></h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="POST" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="username"
                 class="form-lable">Username</label>
                <input
                 name="username"
                 id="username"
                  type="text" 
                  class="form-control" 
                    placeholder="Enter your username"
                  required>
                <div class="valid-feedback">
                    Username looks good!
                </div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-lable">Email</label>
                <input 
                name="email"
                id="email" 
                type="email" 
                class="form-control"
                placeholder="Enter your email"
                 required>
            </div>
            <div class="mb-3">
                <label for="password" 
                class="form-lable">Password</label>
                <input name="password" 
                placeholder="Enter your password"
                 type="password"
                 class="form-control"
                 required>
                <div class="valid-feedback">
                    Password looks good!
                </div>
            </div>
            <button class="btn btn-dark mt-3">Sign Up</button>

        </form>
      </div>
      </div>